API_BASE_URL=https://entrenaya-production.up.railway.app
# Same private value as ADMIN_API_KEY in FastAPI. Never use NEXT_PUBLIC_ for these values.
ADMIN_API_KEY=
# At least 12 characters; only the operator uses this password.
ADMIN_PASSWORD=
# Random secret of at least 32 characters.
ADMIN_SESSION_SECRET=
# Temporary open access. Keep false to require the administrative password.
ADMIN_DEMO_MODE=false
