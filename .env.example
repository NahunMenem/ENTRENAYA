# OAuth 2.0 Client ID for the EntrenaYa web application in Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ADMIN_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local PostgreSQL. In Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/entrenaya

# Generate a random value with at least 32 characters. Keep this secret outside source control.
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
